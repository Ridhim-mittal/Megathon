# Cache rules for static hosts that read this file (Netlify, Cloudflare Pages). vercel.json has the
# same rules for Vercel. Built files have the content hash in their name, so they can be kept a year;
# the page and the offline worker are always re-checked, so a new version reaches students at once.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/audio/*
  Cache-Control: public, max-age=604800
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
